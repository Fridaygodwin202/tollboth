# Server
PORT=4000

# Supabase (server-side — service role key, never exposed to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Binance Agent OS — testnet is the default for every session (see ruleset Section 9.2).
# Mainnet vars are declared here for naming consistency only — do NOT populate
# until an explicitly-scoped go-live session, and never both at once in real use.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# Agent OS mode this session runs in. See ruleset Section 9.2 — must be "testnet"
# unless this is the go-live session.
AGENT_OS_MODE=testnet

# Agent's own buyer wallet — a plain EOA private key, testnet funds only.
# Generate a fresh key for this project; never reuse a real-funds key.
AGENT_WALLET_PRIVATE_KEY=

# Hard spend caps enforced in code (see src/lib/spend-limit.ts). Both required —
# there is no default, an unset limit is a safety issue, not a convenience.
SPEND_LIMIT_MAX_PER_REQUEST_USD=1
SPEND_LIMIT_MAX_PER_SESSION_USD=5

# Which x402 network the buyer flow will pay on. Must match a network string
# the resource server actually offers in its 402 accepts[] array.
X402_PREFERRED_NETWORK=bsc-testnet

# Decimals of the payment asset (6 for USDC-style stablecoins). Used only to
# convert atomic amounts to USD for the spend-limit check.
X402_ASSET_DECIMALS=6

# --- Mock seller (Session 3) --- NOT real B402, see README's scope note.
# Price the mock seller charges per request.
MOCK_SELLER_PRICE_USD=0.5

# A testnet EVM address to receive (simulated) payment. Any address you
# control works — no real settlement happens, but a real address keeps the
# EIP-712 message shape realistic. Do not leave blank; a missing value
# fails loudly rather than defaulting to a placeholder.
MOCK_SELLER_PAYOUT_ADDRESS=

# Placeholder "asset contract" address used only as the EIP-712
# verifyingContract for the mock domain. Since no real settlement occurs,
# any consistent address works as long as buyer and seller agree — but it
# must still be set explicitly, not silently defaulted.
X402_MOCK_ASSET_ADDRESS=

# --- Real Binance Agent OS touchpoint (Session 6) ---
# The actual Agent OS MCP server. Best-effort connection — Binance's docs
# only document interactive-client OAuth setup, not headless server access,
# so this may simply fail and fall back to the public REST API below.
AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic

# Symbol and volatility threshold used to decide whether the agent should
# buy the premium signal.
AGENT_OS_CHECK_SYMBOL=BTCUSDT
AGENT_OS_VOLATILITY_THRESHOLD_PCT=1
