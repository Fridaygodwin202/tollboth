# Server
PORT=4000

# Supabase (server-side — service role key, never exposed to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Binance Agent OS — testnet is the default for every session (see ruleset Section 9.2).
# Mainnet vars are declared here for naming consistency only — do NOT populate
# until an explicitly-scoped go-live session, and never both at once in real use.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# Agent OS mode this session runs in. See ruleset Section 9.2 — must be "testnet"
# unless this is the go-live session.
AGENT_OS_MODE=testnet
